# Copiar a .env (no se commitea). Un solo prefijo: TECNIFIN_*.
# Base PostgreSQL de la plataforma (nunca DATABASE_URL ni PGHOST: se ignoran a proposito).
TECNIFIN_PG_HOST=127.0.0.1
TECNIFIN_PG_PORT=5432
TECNIFIN_PG_DATABASE=tecnifin_dev
TECNIFIN_PG_SSL=false

# Rol de la APLICACION: solo DML, no es dueno de ninguna tabla, sin BYPASSRLS.
# Es el unico con el que se conecta el backend (ADR-0002).
TECNIFIN_PG_USER=tecnifin_app
TECNIFIN_PG_PASSWORD=

# Rol MIGRADOR: dueno del esquema, ejecuta db/migrations. La aplicacion no lo usa.
TECNIFIN_PG_ADMIN_USER=tecnifin_admin
TECNIFIN_PG_ADMIN_DB_PASSWORD=

# Clave del superusuario postgres. Solo para tools/init-db.mjs (crear roles y base
# locales) y para las pruebas de integracion, que crean y borran su propia base efimera.
TECNIFIN_PG_ADMIN_PASSWORD=

# Base de DEMOSTRACION, separada de la de trabajo. El nombre TIENE que terminar en _demo:
# npm run demo:crear la borra y la vuelve a crear entera. Si se deja vacio, tecnifin_demo.
TECNIFIN_PG_DEMO_DATABASE=tecnifin_demo
# Clave unica de los usuarios de la demo. Sin ella la demo se crea igual, pero con un hash
# irrepetible: los datos se pueden mirar y nadie entra.
TECNIFIN_DEMO_PASSWORD=

# Servidor y JWT de la aplicacion. La clave de firma debe tener al menos 32 bytes.
# La vida, refresh e invalidacion del token son parametros de cada cooperativa.
TECNIFIN_PORT=3000
TECNIFIN_JWT_SECRET=
TECNIFIN_JWT_ISSUER=
TECNIFIN_JWT_AUDIENCE=

# Correo saliente (recuperacion de clave y pruebas). Sin esto la aplicacion arranca, pero no envia correos.
# La clave nunca se versiona ni se muestra en el diagnostico.
TECNIFIN_SMTP_HOST=
TECNIFIN_SMTP_PORT=587
TECNIFIN_SMTP_SECURE=false
TECNIFIN_SMTP_USER=
TECNIFIN_SMTP_PASS=
TECNIFIN_SMTP_FROM=
