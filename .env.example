# Copiar a .env (no se commitea). Un solo prefijo: TECNIFIN_*.
# Base PostgreSQL de la plataforma (nunca DATABASE_URL ni PGHOST: se ignoran a proposito).
TECNIFIN_PG_HOST=127.0.0.1
TECNIFIN_PG_PORT=5432
TECNIFIN_PG_DATABASE=tecnifin_dev
TECNIFIN_PG_SSL=false

# Rol de la APLICACION: solo DML, no es dueno de ninguna tabla, sin BYPASSRLS.
# Es el unico con el que se conecta el backend (ADR-0002).
TECNIFIN_PG_USER=tecnifin_app
TECNIFIN_PG_PASSWORD=

# Rol MIGRADOR: dueno del esquema, ejecuta db/migrations. La aplicacion no lo usa.
TECNIFIN_PG_ADMIN_USER=tecnifin_admin
TECNIFIN_PG_ADMIN_DB_PASSWORD=

# Clave del superusuario postgres. Solo para tools/init-db.mjs (crear roles y base
# locales) y para las pruebas de integracion, que crean y borran su propia base efimera.
TECNIFIN_PG_ADMIN_PASSWORD=
